# Copia este archivo como .env para trabajar en local.
# En producción, configura las mismas variables en el panel de Hostinger ANTES de desplegar
# (las variables VITE_ se incrustan en la web al compilar).

# Webhook de n8n del chat Nexura (obligatorio HTTPS con dominio, no una IP)
VITE_NEXURA_WEBHOOK_URL=
VITE_NEXURA_AUDIO_FIELD=data

# Webhook de n8n que recibe el formulario de contacto (vacío = abre el correo del visitante)
VITE_CONTACT_FORM_ENDPOINT=

# Enlaces opcionales (vacío = no se muestran)
VITE_CALENDLY_URL=
VITE_GITHUB_URL=
VITE_LABS_URL=
